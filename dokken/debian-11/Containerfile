# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/debian:11
FROM ${BASE_IMAGE}

# Bullseye reached end of life and was moved to archive.debian.org, so the
# pool on deb.debian.org no longer has the packages its indexes list.
# hadolint ignore=DL3015
RUN <<EOF
  sed -i 's|http://deb.debian.org/|http://archive.debian.org/|' /etc/apt/sources.list
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get -y install \
    apt-utils \
    cron \
    curl \
    dbus \
    dirmngr \
    dmidecode \
    gnupg \
    ifupdown \
    iptables \
    iputils-ping \
    kmod \
    less \
    locales \
    lsb-release \
    lsof \
    net-tools \
    netcat \
    nmap \
    perl \
    procps \
    strace \
    sudo \
    systemd \
    tcpdump \
    telnet \
    tzdata \
    udev \
    vim-tiny \
    wget
  apt-get clean
  apt-get -y autoremove
  rm -rf /tmp/* /var/tmp/*
  ln -s /bin/mkdir /usr/bin/mkdir
  find /etc/systemd/system \
    /lib/systemd/system \
    -path '*.wants/*' \
    \( -name '*getty*' \
    -or -name '*apt-daily*' \
    -or -name '*systemd-timesyncd*' \
    -or -name '*systemd-logind*' \
    -or -name '*systemd-vconsole-setup*' \
    -or -name '*systemd-readahead*' \
    -or -name '*udev*' \) \
    -exec rm -v {} \;
  systemctl set-default multi-user.target
  systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount network.service
EOF

# Distrust the roots that the compromised eMudhra intermediates chain to
# (https://emudhra.we-have-a-problem.com/), whether or not this release
# ships a patched ca-certificates.
RUN <<EOF
  sed -i \
    -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' \
    -e 's|^mozilla/Comodo_AAA_Services_root.crt|!&|' \
    /etc/ca-certificates.conf &&
  update-ca-certificates --fresh
EOF

CMD [ "/bin/systemd" ]
