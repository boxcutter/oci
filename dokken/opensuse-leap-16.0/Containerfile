# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/opensuse/leap:16.0
FROM ${BASE_IMAGE}

# hadolint ignore=DL3037
RUN zypper update -y && \
  zypper install -y \
  aaa_base \
  aaa_base-extras \
  ca-certificates \
  cron \
  curl \
  dmidecode \
  e2fsprogs \
  file \
  findutils \
  glibc-locale \
  grep \
  gzip \
  hostname \
  iproute2 \
  iputils \
  less \
  lsb-release \
  ncurses-devel \
  net-tools \
  perl-Getopt-Long-Descriptive \
  sudo \
  systemd \
  sysvinit-tools \
  tar \
  time \
  timezone \
  traceroute \
  util-linux \
  vim \
  wget \
  which && \
  zypper clean -a && \
  rm -rf /var/log/* /tmp/* /var/tmp/* && \
  # Don't start any optional services.
  find /etc/systemd/system \
  /usr/lib/systemd/system \
  -path '*.wants/*' \
  \( -name '*getty*' \
  -or -name '*systemd-logind*' \
  -or -name '*systemd-vconsole-setup*' \
  -or -name '*systemd-readahead*' \
  -or -name '*udev*' \) \
  -exec rm -v {} \; && \
  systemctl set-default multi-user.target && \
  systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount network.service && \
  # Let systemd generate a unique machine-id in each container
  truncate -s 0 /etc/machine-id

# Distrust the roots that the compromised eMudhra intermediates chain to
# (https://emudhra.we-have-a-problem.com/), whether or not this release
# ships a patched ca-certificates.
RUN <<'EOF'
  d=/etc/pki/trust/blocklist
  [ -d "$d" ] || d=/etc/pki/trust/blacklist
  for root in "Comodo AAA Services root" "emSign ECC Root CA - G3"; do
    trust extract --format=pem-bundle \
      --filter="pkcs11:object=$(echo "$root" | sed 's/ /%20/g');type=cert" \
      "$d/$(echo "$root" | tr ' ' '_').pem" || exit 1
  done
  update-ca-certificates
EOF

CMD [ "/usr/lib/systemd/systemd" ]
