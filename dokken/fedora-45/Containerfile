# syntax=docker/dockerfile:1
ARG BASE_IMAGE="docker.io/fedora:45"
FROM ${BASE_IMAGE}

# hadolint ignore=DL3041
RUN <<EOF
mkdir /var/cache/libdnf5
dnf -y install \
  binutils \
  ca-certificates \
  cronie \
  curl \
  dmidecode \
  ethtool \
  file \
  fipscheck \
  gnupg2 \
  hostname \
  initscripts \
  iproute \
  iptables \
  iputils \
  less \
  lsof \
  nc \
  net-tools \
  nmap \
  openssl \
  passwd \
  procps \
  python3-dnf \
  strace \
  sudo \
  systemd-sysv \
  systemd-udev \
  tcpdump \
  telnet \
  util-linux \
  vim-minimal \
  wget \
  libxcrypt-compat \
  which
  dnf upgrade -y
  dnf clean all
  rm -rf /var/cache/dnf/* /var/lib/dnf/history* /var/lib/rpm/__db.* /var/log/* /tmp/* /var/tmp/*
  find /etc/systemd/system \
	  /lib/systemd/system \
	  -path '*.wants/*' \
	  \( -name '*getty*' \
	  -or -name '*systemd-logind*' \
	  -or -name '*systemd-vconsole-setup*' \
	  -or -name '*systemd-readahead*' \
	  -or -name '*kdump*' \
	  -or -name '*dnf-makecache*' \
	  -or -name '*udev*' \) \
	  -exec rm -v {} \;
  systemctl set-default multi-user.target
  systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount network.service systemd-journal-flush.service
  # Let systemd generate a unique machine-id in each container
  truncate -s 0 /etc/machine-id
EOF

# Distrust the roots that the compromised eMudhra intermediates chain to
# (https://emudhra.we-have-a-problem.com/), whether or not this release
# ships a patched ca-certificates.
RUN <<'EOF'
  d=/etc/pki/ca-trust/source/blocklist
  [ -d "$d" ] || d=/etc/pki/ca-trust/source/blacklist
  for root in "Comodo AAA Services root" "emSign ECC Root CA - G3"; do
    trust extract --overwrite --format=pem-bundle \
      --filter="pkcs11:object=$(echo "$root" | sed 's/ /%20/g');type=cert" \
      "$d/$(echo "$root" | tr ' ' '_').pem" || exit 1
  done
  update-ca-trust
EOF

CMD [ "/usr/lib/systemd/systemd" ]
