# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/ubuntu:noble-20260324
FROM $BASE_IMAGE AS download

ARG CINC_URL_AMD64
ARG CINC_SHA256_AMD64
ARG CINC_URL_ARM64
ARG CINC_SHA256_ARM64

# This argument is automatically populated by BuildKit
ARG TARGETARCH

WORKDIR /tmp/cinc

# Upstream does this download within busybox using the busybox wget.
# On arm64, this tends result in "connection dropped" on downloads on github
# runners (or self-hosted runners). We've tried not checking SSL certs and
# it still fails, so instead move the download outside of busybox which has
# more complete certs and SSL implementation as a workaround. Seems to
# work better.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN <<EOF
  set -e
  apt-get install -y --update --no-install-recommends \
    ca-certificates \
    curl
  rm -rf /var/lib/apt/lists/*
  dpkgArch="$(dpkg --print-architecture)" 
  case "$TARGETARCH" in \
    amd64) \
      CINC_URL=${CINC_URL_AMD64} \
      CINC_SHA256=${CINC_SHA256_AMD64} \
      ;; \
    arm64) \
      CINC_URL=${CINC_URL_ARM64} \
      CINC_SHA256=${CINC_SHA256_ARM64} \
      ;; \
     *) echo "unsupported architecture"; exit 1 ;; \
  esac
  curl -fsSL -o cinc-client.rpm "${CINC_URL}"
  echo "${CINC_SHA256} cinc-client.rpm" | sha256sum -c -
EOF

# The CA bundles inside the cinc package trust the roots that the
# compromised eMudhra intermediates chain to
# (https://emudhra.we-have-a-problem.com/). Build a bundle without them to
# put in their place.
RUN <<EOF
  sed -i \
    -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' \
    -e 's|^mozilla/Comodo_AAA_Services_root.crt|!&|' \
    /etc/ca-certificates.conf &&
  update-ca-certificates --fresh &&
  cp /etc/ssl/certs/ca-certificates.crt /tmp/cinc/ca-bundle.pem
EOF


FROM docker.io/busybox:stable

COPY --from=download /tmp/cinc/cinc-client.rpm /tmp/cinc-client.rpm
COPY --from=download /tmp/cinc/ca-bundle.pem /tmp/ca-bundle.pem

# Because this is a data container and is never run, only mounted via
# the --volumes-from parameter, the operating system type doesn't matter.
# So we use busybox, a really small distro, with just enough support to
# be able to download and install the binaries for cinc.

# We're using busybox with /bin/sh so DL4006 does not apply
# hadolint ignore=DL4006
RUN <<EOF
  set -e
  # Since busybox includes tools to extract rpm packages, we fetch the rpm
  # package for cinc-client. However since this is a data volume and this
  # container never actually runs, this will work with any OS distro, as it
  # is just serving the binaries to run on other OS, like an NFS mount.
  rpm2cpio /tmp/cinc-client.rpm | cpio -idm
  [ -e /opt/cinc/bin/cinc-client ] || { echo "missing /opt/cinc/bin/cinc-client" >&2; exit 1; }
  rm -f /tmp/cinc-client.rpm
  # Replace the package's own CA bundles (OpenSSL's and the copies some gems
  # carry) with the one built above.
  find /opt/cinc/embedded -type f \( -name cacert.pem -o -name ca-bundle.crt \) \
    -exec cp /tmp/ca-bundle.pem {} \;
  rm -f /tmp/ca-bundle.pem
EOF

VOLUME [ "/opt/cinc" ]
