# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/ubuntu:resolute-20261024.1
# hadolint ignore=DL3006
FROM $BASE_IMAGE AS base

FROM base AS build

ARG MESHCMD_URL_AMD64
ARG MESHCMD_SHA256_AMD64
ARG MESHCMD_URL_ARM64
ARG MESHCMD_SHA256_ARM64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Heredocs don't stop on errors by default, so set -e is needed for a failed
# checksum to fail the build
RUN <<EOF
  set -eux
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl
  dpkgArch="$(dpkg --print-architecture)"
  case "${dpkgArch##*-}" in
    amd64)
      MESHCMD_URL="${MESHCMD_URL_AMD64}"
      MESHCMD_SHA256="${MESHCMD_SHA256_AMD64}"
      ;;
    arm64)
      MESHCMD_URL="${MESHCMD_URL_ARM64}"
      MESHCMD_SHA256="${MESHCMD_SHA256_ARM64}"
      ;;
    *) echo "unsupported architecture"; exit 1 ;;
  esac
  mkdir -p /tmp/meshcmd
  curl -fsSL -o /tmp/meshcmd/meshcmd "${MESHCMD_URL}"
  echo "${MESHCMD_SHA256} /tmp/meshcmd/meshcmd" | sha256sum -c -
  rm -rf /var/lib/apt/lists/*
EOF

FROM base

WORKDIR /opt/meshcmd/bin

COPY --from=build --chmod=755 /tmp/meshcmd/meshcmd /opt/meshcmd/bin/meshcmd

ENV PATH="/opt/meshcmd/bin:${PATH}"
EXPOSE 3000

ENTRYPOINT ["meshcmd"]
