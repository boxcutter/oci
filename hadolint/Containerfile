# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/ubuntu:resolute-20261006
FROM $BASE_IMAGE AS base

FROM base AS download

ARG HADOLINT_URL_AMD64
ARG HADOLINT_SHA256_AMD64
ARG HADOLINT_URL_ARM64
ARG HADOLINT_SHA256_ARM64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN <<EOF
  set -e
  apt-get install --update --no-install-recommends -y \
    ca-certificates \
    curl
  rm -rf /var/lib/apt/lists/*
  dpkgArch="$(dpkg --print-architecture)"
  case "${dpkgArch##*-}" in
    amd64)
      HADOLINT_URL="${HADOLINT_URL_AMD64}"
      HADOLINT_SHA256="${HADOLINT_SHA256_AMD64}"
      ;;
    arm64)
      HADOLINT_URL="${HADOLINT_URL_ARM64}"
      HADOLINT_SHA256="${HADOLINT_SHA256_ARM64}"
      ;;
    *) echo "unsupported architecture: ${dpkgArch}"; exit 1 ;;
  esac
  curl -fsSL -o /tmp/hadolint "${HADOLINT_URL}"
  echo "${HADOLINT_SHA256} /tmp/hadolint" | sha256sum -c -
EOF

FROM base
COPY --from=download --chmod=755 /tmp/hadolint /usr/local/bin/hadolint
WORKDIR /shared
COPY hadolint.yaml .hadolint.yaml
CMD ["/usr/local/bin/hadolint", "-"]
