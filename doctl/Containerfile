# syntax=docker/dockerfile:1
ARG BASE_IMAGE=docker.io/ubuntu:resolute-20261024.1
# hadolint ignore=DL3006
FROM ${BASE_IMAGE} AS base

FROM base AS build

ARG DOCTL_URL_AMD64
ARG DOCTL_SHA256_AMD64
ARG DOCTL_URL_ARM64
ARG DOCTL_SHA256_ARM64
ARG KUBECTL_URL_AMD64
ARG KUBECTL_SHA256_AMD64
ARG KUBECTL_URL_ARM64
ARG KUBECTL_SHA256_ARM64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Heredocs don't stop on errors by default, so set -e is needed for a failed
# checksum to fail the build
RUN <<EOF
  set -eux
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl
  dpkgArch="$(dpkg --print-architecture)"
  case "${dpkgArch##*-}" in
    amd64)
      DOCTL_URL="${DOCTL_URL_AMD64}"
      DOCTL_SHA256="${DOCTL_SHA256_AMD64}"
      KUBECTL_URL="${KUBECTL_URL_AMD64}"
      KUBECTL_SHA256="${KUBECTL_SHA256_AMD64}"
      ;;
    arm64)
      DOCTL_URL="${DOCTL_URL_ARM64}"
      DOCTL_SHA256="${DOCTL_SHA256_ARM64}"
      KUBECTL_URL="${KUBECTL_URL_ARM64}"
      KUBECTL_SHA256="${KUBECTL_SHA256_ARM64}"
      ;;
    *) echo "unsupported architecture"; exit 1 ;;
  esac
  curl -fsSL -o /tmp/doctl.tar.gz "${DOCTL_URL}"
  echo "${DOCTL_SHA256} /tmp/doctl.tar.gz" | sha256sum -c -
  mkdir -p /tmp/doctl
  tar -xzf /tmp/doctl.tar.gz -C /tmp/doctl

  curl -fsSL -o /tmp/kubectl "${KUBECTL_URL}"
  echo "${KUBECTL_SHA256} /tmp/kubectl" | sha256sum -c -

  rm -rf /var/lib/apt/lists/*
EOF

FROM base

RUN <<EOF
  set -eux
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    jq \
    openssh-client \
    vim \
    nano
  rm -rf /var/lib/apt/lists/*
EOF

RUN useradd -m doctl
USER doctl
WORKDIR /home/doctl

COPY --from=build --chmod=0755 /tmp/doctl/doctl /usr/local/bin/doctl
COPY --from=build --chmod=0755 /tmp/kubectl /usr/local/bin/kubectl

CMD ["/usr/local/bin/doctl"]
